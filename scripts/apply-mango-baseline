#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APPLY=0
INSTALL_PACKAGES=0
APPLY_OBSIDIAN_OVERRIDE=0

usage() {
  cat <<'EOF'
Usage: scripts/apply-mango-baseline [options]

Safe Fedora Mango baseline deployer for DMS KDE Workstation.
Dry-run is the default. Nothing is written unless --apply is passed.

Options:
  --apply                       Write files and run user-level setup actions.
  --install-packages            Install approved baseline packages with dnf.
                                Requires sudo and uses temporary Terra repo for mangowm.
  --obsidian-override           Apply tested Obsidian Flatpak Wayland/DnD override if installed.
  -h, --help                    Show this help.

Examples:
  scripts/apply-mango-baseline
  scripts/apply-mango-baseline --apply
  scripts/apply-mango-baseline --apply --obsidian-override
  scripts/apply-mango-baseline --apply --install-packages
EOF
}

log() { printf '%s\n' "$*"; }
fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}
run() {
  if [ "$APPLY" -eq 1 ]; then
    log "+ $*"
    "$@"
  else
    log "DRY-RUN: $*"
  fi
}

ensure_backup_root() {
  local dir="$HOME/.local/state/dms-kde-workstation/backups"
  if [ "$APPLY" -eq 0 ]; then
    return 0
  fi
  if ! mkdir -p "$dir" 2>/dev/null; then
    fail "Cannot create backup directory: $dir

This usually means a previous broken/privileged run created root-owned files under ~/.local/state/dms-kde-workstation.
Fix ownership from your current working session, then re-run:

  sudo chown -R \"$USER:$USER\" \"$HOME/.local/state/dms-kde-workstation\"
  chmod -R u+rwX \"$HOME/.local/state/dms-kde-workstation\""
  fi
  if [ ! -w "$dir" ]; then
    fail "Backup directory is not writable: $dir

Fix ownership from your current working session, then re-run:

  sudo chown -R \"$USER:$USER\" \"$HOME/.local/state/dms-kde-workstation\"
  chmod -R u+rwX \"$HOME/.local/state/dms-kde-workstation\""
  fi
}

backup_file() {
  local target="$1"
  [ -e "$target" ] || return 0
  local stamp backup_dir backup
  stamp="$(date +%Y%m%d-%H%M%S)"
  backup_dir="$HOME/.local/state/dms-kde-workstation/backups/$stamp"
  backup="$backup_dir${target#$HOME}"
  if [ "$APPLY" -eq 1 ]; then
    ensure_backup_root
    if ! mkdir -p "$(dirname "$backup")"; then
      fail "Cannot create backup path for $target.

Fix ownership from your current working session, then re-run:

  sudo chown -R \"$USER:$USER\" \"$HOME/.local/state/dms-kde-workstation\"
  chmod -R u+rwX \"$HOME/.local/state/dms-kde-workstation\""
    fi
    cp -a "$target" "$backup"
    log "Backed up $target -> $backup"
  else
    log "DRY-RUN: backup $target -> $backup"
  fi
}

install_file() {
  local src="$1" target="$2" mode="${3:-0644}"
  if [ ! -f "$src" ]; then
    log "ERROR: source missing: $src" >&2
    exit 1
  fi
  backup_file "$target"
  if [ "$APPLY" -eq 1 ]; then
    mkdir -p "$(dirname "$target")"
    tee "$target" >/dev/null < "$src"
    chmod "$mode" "$target"
    log "Installed $target"
  else
    log "DRY-RUN: install $src -> $target mode $mode"
  fi
}

install_template_file() {
  local src="$1" target="$2" mode="${3:-0644}"
  if [ ! -f "$src" ]; then
    log "ERROR: source missing: $src" >&2
    exit 1
  fi
  backup_file "$target"
  if [ "$APPLY" -eq 1 ]; then
    mkdir -p "$(dirname "$target")"
    sed "s|%H|$HOME|g" "$src" | tee "$target" >/dev/null
    chmod "$mode" "$target"
    log "Installed $target"
  else
    log "DRY-RUN: install template $src -> $target mode $mode"
  fi
}

install_packages() {
  local fedora_packages=(
    qt5ct qt6ct-kde python3-pyside6
    dolphin kate okular gwenview ark kcalc filelight kwalletmanager5 plasma-discover kde-partitionmanager
    xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk xdg-desktop-portal-kde
    blueman pavucontrol qpwgraph firewall-config system-config-printer gparted flatseal
    fuzzel wl-clipboard grim slurp swappy wf-recorder
    git gcc make wayland-devel wayland-protocols-devel scdoc
  )

  # Terra repo — skip if already configured (idempotent)
  if rpm -q terra-release >/dev/null 2>&1; then
    log "terra-release already installed, skipping repo setup"
  else
    if ! run sudo dnf install -y --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release; then
      log "WARNING: terra-release install failed. If terra repo is already configured, this is safe to ignore."
      log "If Mango is not installed, you will need to set up the terra repo manually."
    fi
  fi

  # Mango — skip if already installed
  if command -v mango >/dev/null 2>&1; then
    log "mangowm already installed: $(mango --version 2>/dev/null || echo 'unknown version')"
  else
    if ! run sudo dnf install -y mangowm; then
      log "WARNING: mangowm install failed. Install it manually before proceeding."
    fi
  fi

  # KDE/Qt workstation and helper packages — install individually so one failure doesn't block the rest
  local failed=()
  for pkg in "${fedora_packages[@]}"; do
    if rpm -q "$pkg" >/dev/null 2>&1; then
      : # already installed, skip
    else
      if ! run sudo dnf install -y "$pkg"; then
        failed+=("$pkg")
      fi
    fi
  done
  if [ ${#failed[@]} -gt 0 ]; then
    log ""
    log "WARNING: Some packages failed to install: ${failed[*]}"
    log "The baseline files will still be deployed. You can install missing packages later with:"
    log "  sudo dnf install ${failed[*]}"
    log ""
  fi
}

install_lswt() {
  if command -v lswt >/dev/null 2>&1; then
    log "lswt already installed: $(command -v lswt)"
    return 0
  fi
  log "lswt missing; installing from source for reliable Mango window-rule selection"
  log "Why: Window Rules needs app IDs for open windows, and Fedora does not package lswt yet."
  if [ "$APPLY" -eq 0 ]; then
    log "DRY-RUN: git clone https://git.sr.ht/~leon_plickat/lswt ~/.local/src/lswt"
    log "DRY-RUN: make -C ~/.local/src/lswt"
    log "DRY-RUN: sudo make -C ~/.local/src/lswt install"
    return 0
  fi
  local src_dir="$HOME/.local/src/lswt"
  if ! mkdir -p "$(dirname "$src_dir")"; then
    log "WARNING: Could not create source directory parent: $(dirname "$src_dir")"
    log "Fix manually: mkdir -p '$HOME/.local/src'"
    return 0
  fi
  if [ -d "$src_dir/.git" ]; then
    if ! git -C "$src_dir" pull --ff-only; then
      log "WARNING: Could not update existing lswt checkout: $src_dir"
      log "Fix manually: cd '$src_dir' && git pull --ff-only"
      return 0
    fi
  else
    if ! git clone https://git.sr.ht/~leon_plickat/lswt "$src_dir"; then
      log "WARNING: Could not clone lswt. Window Rules open-window picker will not work."
      log "Fix manually: git clone https://git.sr.ht/~leon_plickat/lswt '$src_dir'"
      return 0
    fi
  fi
  if ! make -C "$src_dir"; then
    log "WARNING: Could not build lswt. Window Rules open-window picker will not work."
    log "Install build deps and retry: sudo dnf install -y git gcc make wayland-devel wayland-protocols-devel scdoc"
    log "Then run: make -C '$src_dir'"
    return 0
  fi
  if ! sudo make -C "$src_dir" install; then
    log "WARNING: Could not install lswt. Window Rules open-window picker will not work."
    log "Fix manually: sudo make -C '$src_dir' install"
    return 0
  fi
  if command -v lswt >/dev/null 2>&1; then
    log "Installed lswt: $(command -v lswt)"
  else
    log "WARNING: lswt install finished but command is not in PATH."
    log "Fix manually: ensure /usr/local/bin is in PATH or run: /usr/local/bin/lswt"
  fi
}

check_prerequisites() {
  log "Preflight checks:"
  log "  - run this from your current working KDE/niri session"
  log "  - do NOT switch to Mango until this script completes successfully"

  # Ghostty crashes (SEGV in fontconfig) when dnf installs font packages.
  # This kills the terminal mid-install, leaving the machine in a broken state.
  local parent_term
  parent_term="$(ps -o comm= -p $PPID 2>/dev/null || true)"
  if [ "$parent_term" = "ghostty" ]; then
    log ""
    log "ERROR: This script is running inside Ghostty."
    log "Installing packages via dnf rebuilds the fontconfig cache, which"
    log "crashes Ghostty (fontconfig SEGV in FcConfigDestroy) and kills"
    log "your terminal mid-install, leaving the machine in a broken state."
    log ""
    log "Switch to a different terminal first, then re-run this script."
    log "Safe options:"
    log "  - SSH into this machine and run from there"
    log "  - Use Konsole, Kitty, or any non-GTK4 terminal"
    log "  - Open a TTY (Ctrl+Alt+F3) and run from there"
    if [ "$INSTALL_PACKAGES" -eq 1 ]; then
      fail "Cannot proceed with --install-packages inside Ghostty. Switch terminals first."
    else
      log ""
      log "WARNING: Continuing without --install-packages. Package install was not requested."
      log ""
    fi
  fi

  if ! command -v dms >/dev/null 2>&1; then
    fail "DMS is not installed. Install it first, then re-run this script. Fedora example: sudo dnf copr enable avengemedia/dms && sudo dnf install dms"
  fi

  if ! command -v qs >/dev/null 2>&1 && ! command -v quickshell >/dev/null 2>&1; then
    fail "Quickshell is not available (missing 'qs'/'quickshell'). Fix your DMS install first, then re-run this script."
  fi

  if [ "$INSTALL_PACKAGES" -eq 0 ] && ! command -v mango >/dev/null 2>&1; then
    fail "Mango is not installed. Install Mango first or re-run with --install-packages. Do not log into Mango yet."
  fi
}

install_polkit_policy() {
  local src="$ROOT/configs/polkit/io.dms-kde-workstation.sddm-autologin.policy"
  local target="/usr/share/polkit-1/actions/io.dms-kde-workstation.sddm-autologin.policy"
  if [ ! -f "$src" ]; then
    log "WARNING: polkit policy source missing: $src"
    return 0
  fi
  if [ "$APPLY" -eq 1 ]; then
    if sed "s|%H|$HOME|g" "$src" | pkexec tee "$target" >/dev/null 2>&1; then
      pkexec chmod 644 "$target"
      log "Installed polkit policy: $target"
    else
      log ""
      log "WARNING: Could not install polkit policy automatically."
      log "Run this command manually to enable autologin via the GUI:"
      log "  sed 's|%H|$HOME|g' $src | sudo tee $target >/dev/null"
      log "  sudo chmod 644 $target"
      log ""
    fi
  else
    log "DRY-RUN: install polkit policy $src -> $target"
  fi
}

apply_files() {
  install_template_file "$ROOT/configs/mango/config.conf.working-20260516" \
    "$HOME/.config/mango/config.conf" 0644

  install_file "$ROOT/configs/systemd-user/xdg-desktop-portal.service.mango-override-20260516" \
    "$HOME/.config/systemd/user/xdg-desktop-portal.service" 0644

  install_file "$ROOT/configs/xdg-desktop-portal/mango-portals.conf.working-20260516" \
    "$HOME/.config/xdg-desktop-portal/mango-portals.conf" 0644

  install_file "$ROOT/configs/environment.d/90-dms-kde-qt.conf" \
    "$HOME/.config/environment.d/90-dms-kde-qt.conf" 0644

  install_file "$ROOT/configs/scripts/dms-region-screenshot-edit" \
    "$HOME/.local/bin/dms-region-screenshot-edit" 0755
  install_file "$ROOT/configs/scripts/dms-full-screenshot-edit" \
    "$HOME/.local/bin/dms-full-screenshot-edit" 0755
  install_file "$ROOT/configs/scripts/dms-region-screenshot-copy" \
    "$HOME/.local/bin/dms-region-screenshot-copy" 0755
  install_file "$ROOT/configs/scripts/mango-workstation-menu" \
    "$HOME/.local/bin/mango-workstation-menu" 0755

  install_file "$ROOT/tools/dms-mango-settings.py" \
    "$HOME/.local/bin/dms-mango-settings" 0755

  install_file "$ROOT/scripts/dms-mango-post-startup" \
    "$HOME/.local/bin/dms-mango-post-startup" 0755
  install_file "$ROOT/scripts/test-first-mango-readiness" \
    "$HOME/.local/bin/test-first-mango-readiness" 0755

  install_file "$ROOT/configs/lib/sddm-consolidate-autologin.py" \
    "$HOME/.local/lib/dms-kde-workstation/sddm-consolidate-autologin.py" 0755

  install_file "$ROOT/configs/dms-kde-workstation/startup.json" \
    "$HOME/.config/dms-kde-workstation/startup.json" 0644

  install_template_file "$ROOT/configs/applications/dms-region-screenshot-edit.desktop" \
    "$HOME/.local/share/applications/dms-region-screenshot-edit.desktop" 0644
  install_template_file "$ROOT/configs/applications/dms-full-screenshot-edit.desktop" \
    "$HOME/.local/share/applications/dms-full-screenshot-edit.desktop" 0644
  install_template_file "$ROOT/configs/applications/dms-region-screenshot-copy.desktop" \
    "$HOME/.local/share/applications/dms-region-screenshot-copy.desktop" 0644
  install_template_file "$ROOT/configs/applications/dms-mango-settings.desktop" \
    "$HOME/.local/share/applications/dms-mango-settings.desktop" 0644
  install_template_file "$ROOT/configs/applications/dms-mango-settings.desktop" \
    "$HOME/.config/autostart/dms-mango-settings.desktop" 0644
}

apply_user_actions() {
  run systemctl --user daemon-reload

  if command -v systemctl >/dev/null 2>&1; then
    for svc in xdg-desktop-portal.service xdg-desktop-portal-wlr.service xdg-desktop-portal-gtk.service; do
      if systemctl --user list-unit-files "$svc" >/dev/null 2>&1; then
        run systemctl --user restart "$svc"
      else
        log "Skipping $svc: not installed"
      fi
    done
  fi

  log "Skipping automatic DMS appOverrides injection. Keep launcher-specific overrides optional until they are generalized safely."

  if [ "$APPLY_OBSIDIAN_OVERRIDE" -eq 1 ]; then
    if command -v flatpak >/dev/null 2>&1 && flatpak info md.obsidian.Obsidian >/dev/null 2>&1; then
      run flatpak override --user --socket=wayland --env=OBSIDIAN_USE_WAYLAND=1 md.obsidian.Obsidian
    else
      log "Skipping Obsidian override: Flatpak app md.obsidian.Obsidian not installed."
    fi
  fi
}

post_install_report() {
  log ""
  log "Post-install status:"
  local missing=()
  for cmd in mango dms lswt; do
    if command -v "$cmd" >/dev/null 2>&1; then
      log "  OK   $cmd -> $(command -v "$cmd")"
    else
      log "  WARN $cmd missing"
      missing+=("$cmd")
    fi
  done
  if ! command -v qs >/dev/null 2>&1 && ! command -v quickshell >/dev/null 2>&1; then
    log "  WARN quickshell/qs missing"
    missing+=("quickshell")
  else
    log "  OK   quickshell available"
  fi
  if ! python3 -c 'import PySide6' >/dev/null 2>&1; then
    log "  WARN PySide6 missing -> fix: sudo dnf install -y python3-pyside6"
  else
    log "  OK   PySide6 available"
  fi
  for pkg in xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk xdg-desktop-portal-kde; do
    if rpm -q "$pkg" >/dev/null 2>&1; then
      log "  OK   $pkg installed"
    else
      log "  WARN $pkg missing -> fix: sudo dnf install -y $pkg"
    fi
  done
  [ -f "$HOME/.config/mango/config.conf" ] && log "  OK   Mango config deployed" || log "  WARN Mango config missing -> rerun this script with --apply"
  [ -x "$HOME/.local/bin/dms-mango-settings" ] && log "  OK   Settings app installed" || log "  WARN Settings app missing -> rerun this script with --apply"
  if [ ${#missing[@]} -gt 0 ]; then
    log ""
    log "Some optional/required commands are still missing. Use the WARN lines above, then run:"
    log "  $ROOT/scripts/test-first-mango-readiness"
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1 ;;
    --install-packages) INSTALL_PACKAGES=1 ;;
    --obsidian-override) APPLY_OBSIDIAN_OVERRIDE=1 ;;
    -h|--help) usage; exit 0 ;;
    *) log "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

log "DMS KDE Workstation Mango baseline deployer"
log "Project root: $ROOT"
if [ "$APPLY" -eq 1 ]; then
  log "Mode: APPLY"
else
  log "Mode: DRY-RUN"
fi
if [ "$INSTALL_PACKAGES" -eq 1 ]; then
  log "Package install: ENABLED"
else
  log "Package install: disabled"
fi

check_prerequisites
ensure_backup_root

if [ "$INSTALL_PACKAGES" -eq 1 ]; then
  install_packages
  install_lswt
else
  log "Skipping package installation. Use --install-packages to enable it."
fi

log ""
log "Deploying configuration files..."
apply_files
install_polkit_policy
apply_user_actions
post_install_report

cat <<EOF

Next verification steps:
  1. Stay in your current working session until the checks below are understood.
  2. Run: $ROOT/scripts/test-first-mango-readiness
  3. Only if that script says READY, log out.
  4. Choose the Mango session in SDDM.
  5. Log into Mango.
  6. Open DMS -> Settings -> Theme/Colors and export GTK3/GTK4/QT5/QT6 once.
  7. Reboot once.
  8. Run: $ROOT/scripts/dms-workstation-health

Manual checks in the Mango session:
  - confirm DMS bar appears
  - confirm DMS Mango Settings autostarts and shows one tray icon only
  - confirm Alt+Shift toggles US/Greek
  - confirm screenshot shortcuts work
  - confirm portals/file chooser work
  - confirm startup apps appear after next login
EOF

if [ "$APPLY" -eq 0 ]; then
  cat <<'EOF'

This was a dry-run. Re-run with --apply to write files.
EOF
fi
