#!/usr/bin/env bash
set -u

ok() { printf 'OK   %s\n' "$*"; }
warn() { printf 'WARN %s\n' "$*"; }
fail() { printf 'FAIL %s\n' "$*"; }
has() { command -v "$1" >/dev/null 2>&1; }
section() { printf '\n== %s ==\n' "$*"; }
file_has() { [ -f "$1" ] && grep -q -- "$2" "$1"; }

section "Session"
printf 'XDG_SESSION_TYPE=%s\n' "${XDG_SESSION_TYPE:-unset}"
printf 'XDG_CURRENT_DESKTOP=%s\n' "${XDG_CURRENT_DESKTOP:-unset}"
printf 'XDG_SESSION_DESKTOP=%s\n' "${XDG_SESSION_DESKTOP:-unset}"
printf 'WAYLAND_DISPLAY=%s\n' "${WAYLAND_DISPLAY:-unset}"
printf 'DISPLAY=%s\n' "${DISPLAY:-unset}"
case "${XDG_CURRENT_DESKTOP:-}" in
  mango*) ok "Health check is running inside Mango, which is the intended post-login context" ;;
  *) warn "Health check is most useful after a successful Mango login. Before first login, use scripts/test-first-mango-readiness instead." ;;
esac

section "Core commands"
for cmd in dms quickshell mango mmsg niri xwayland-satellite; do
  if has "$cmd"; then ok "$cmd present: $(command -v "$cmd")"; else warn "$cmd missing"; fi
done
if has mango; then mango -v 2>/dev/null || true; fi
[ -f /usr/share/wayland-sessions/mango.desktop ] && ok "Mango session entry present" || warn "Mango session entry missing: /usr/share/wayland-sessions/mango.desktop"

section "Compositor profile"
case "${XDG_CURRENT_DESKTOP:-}" in
  mango*) ok "active compositor appears to be Mango" ;;
  niri*) warn "active compositor is niri; Mango is primary candidate for creative workstation" ;;
  *) warn "unknown/non-target compositor: ${XDG_CURRENT_DESKTOP:-unset}" ;;
esac

section "Mango baseline"
MANGO_CONF="$HOME/.config/mango/config.conf"
if [ -f "$MANGO_CONF" ]; then
  ok "Mango config exists: $MANGO_CONF"
  file_has "$MANGO_CONF" 'exec-once=env QT_QPA_PLATFORMTHEME=qt6ct QT_QPA_PLATFORMTHEME_QT6=qt6ct dms run' && ok "DMS Mango startup configured with qt6ct env" || warn "DMS Mango startup line missing"
  STARTUP_JSON="$HOME/.config/dms-kde-workstation/startup.json"
  if [ -f "$STARTUP_JSON" ]; then
    ok "DMS Mango startup config exists: $STARTUP_JSON"
  else
    warn "DMS Mango startup config missing: $STARTUP_JSON"
  fi
  file_has "$MANGO_CONF" 'layout_name:scroller' && ok "Scroller default tag rules configured" || warn "Scroller default tag rules missing"
  file_has "$MANGO_CONF" 'axisbind=SUPER,DOWN,focusstack,next' && ok "Super+wheel next configured" || warn "Super+wheel next missing"
  file_has "$MANGO_CONF" 'axisbind=SUPER,UP,focusstack,prev' && ok "Super+wheel prev configured" || warn "Super+wheel prev missing"
  file_has "$MANGO_CONF" 'mango-workstation-menu' && ok "Mango Workstation Menu bind configured" || warn "Mango Workstation Menu bind missing"
  file_has "$MANGO_CONF" 'dms-mango-post-startup' && ok "Additive Mango post-startup helper configured" || warn "Mango post-startup helper missing"
  if systemctl --user is-enabled dms.service >/dev/null 2>&1; then
    warn "dms.service still enabled; this can conflict with Mango's explicit dms run startup"
  else
    ok "dms.service not enabled for future sessions"
  fi
  bind_dupes="$(grep -E '^(bind|axisbind)=' "$MANGO_CONF" | cut -d= -f2- | cut -d, -f1-2 | tr '[:upper:]' '[:lower:]' | sort | uniq -d)"
  [ -z "$bind_dupes" ] && ok "No duplicate Mango bind/axisbind keys detected" || warn "Duplicate Mango bind/axisbind keys detected"
else
  fail "Mango config missing: $MANGO_CONF"
fi
if has mmsg && [ "${XDG_CURRENT_DESKTOP:-}" = "mango" ]; then
  mmsg -g -l 2>/dev/null || warn "mmsg current layout failed"
fi

section "Portal services"
for svc in xdg-desktop-portal.service xdg-desktop-portal-kde.service xdg-desktop-portal-wlr.service xdg-desktop-portal-gtk.service; do
  if systemctl --user is-active --quiet "$svc"; then ok "$svc active"; else warn "$svc not active"; fi
done

section "Portal config candidates"
for f in "$HOME/.config/systemd/user/xdg-desktop-portal.service" "$HOME/.config/xdg-desktop-portal/mango-portals.conf" "$HOME/.config/xdg-desktop-portal/niri-portals.conf" "$HOME/.config/xdg-desktop-portal/portals.conf" /usr/share/xdg-desktop-portal/mango-portals.conf; do
  if [ -f "$f" ]; then ok "$f exists"; else warn "$f missing"; fi
done

section "KDE/Qt workstation apps"
for cmd in dolphin kate okular gwenview ark kcalc filelight partitionmanager plasma-discover; do
  if has "$cmd"; then ok "$cmd"; else warn "$cmd missing"; fi
done
if has kwalletmanager || has kwalletmanager5; then ok "kwalletmanager"; else warn "kwalletmanager missing"; fi
has spectacle && warn "spectacle installed but rejected for niri/Mango baseline; use grim/slurp/swappy" || ok "spectacle absent"

section "Admin/helper apps"
for cmd in nm-connection-editor blueman-manager pavucontrol qpwgraph firewall-config system-config-printer fuzzel wl-copy grim slurp swappy wf-recorder; do
  if has "$cmd"; then ok "$cmd"; else warn "$cmd missing"; fi
done
if has flatseal || has com.github.tchx84.Flatseal; then ok "flatseal"; else warn "flatseal missing"; fi

section "Theme baseline"
[ -f "$HOME/.config/qt5ct/qt5ct.conf" ] && grep -q 'custom_palette=true' "$HOME/.config/qt5ct/qt5ct.conf" && ok "qt5ct custom palette configured" || warn "qt5ct custom palette not configured"
[ -f "$HOME/.config/qt6ct/qt6ct.conf" ] && grep -q 'custom_palette=true' "$HOME/.config/qt6ct/qt6ct.conf" && ok "qt6ct custom palette configured" || warn "qt6ct custom palette not configured"
[ -f "$HOME/.config/gtk-3.0/settings.ini" ] && ok "GTK3 settings exist" || warn "GTK3 settings missing"
[ -f "$HOME/.config/gtk-4.0/settings.ini" ] && ok "GTK4 settings exist" || warn "GTK4 settings missing"

section "Default apps"
show_default() {
  local mime="$1" label="$2" actual
  actual="$(xdg-mime query default "$mime" 2>/dev/null || true)"
  if [ -n "$actual" ]; then
    ok "$label: $mime -> $actual"
  else
    warn "$label: $mime has no default app set"
  fi
}
show_default inode/directory "Folders"
show_default application/pdf "PDFs"
show_default image/png "Images"
show_default application/zip "Archives"
show_default text/plain "Text/code"
show_default x-scheme-handler/http "Browser"

section "Flatpak app overrides"
if has flatpak; then
  if flatpak info md.obsidian.Obsidian >/dev/null 2>&1; then
    flatpak info --show-permissions md.obsidian.Obsidian 2>/dev/null | grep -q 'OBSIDIAN_USE_WAYLAND=1' && ok "Obsidian Wayland override configured" || warn "Obsidian Wayland override missing (use the baseline --obsidian-override flag)"
  else
    ok "Obsidian Flatpak not installed; skipping Wayland override check"
  fi
else
  ok "flatpak not installed; skipping app override checks"
fi

section "Agents/services"
for svc in pipewire.service wireplumber.service; do
  if systemctl --user is-active --quiet "$svc"; then ok "$svc active"; else warn "$svc not active"; fi
done
[ -x "$HOME/.local/bin/dms-mango-post-startup" ] && ok "dms-mango-post-startup installed" || warn "dms-mango-post-startup missing"
[ -f "$HOME/.config/dms-kde-workstation/startup.json" ] && ok "DMS Mango startup config exists" || warn "DMS Mango startup config missing"
pgrep -x xembedsniproxy >/dev/null && ok "xembedsniproxy running" || warn "xembedsniproxy not running; XEmbed tray icons may be missing"
pgrep -af 'gnome-keyring|kwallet|ksecretd' >/dev/null && ok "keyring/wallet appears running" || warn "keyring/wallet not detected"

section "Configured tray-ready services"
configured_services=""
if [ -f "$HOME/.config/dms-kde-workstation/startup.json" ]; then
  configured_services="$(python3 -c 'import json, pathlib; p=pathlib.Path.home()/".config/dms-kde-workstation/startup.json"; data=json.loads(p.read_text()); [print(x) for x in data.get("tray_ready_services", []) if isinstance(x, str)]' 2>/dev/null || true)"
  if [ -n "$configured_services" ]; then
    while IFS= read -r svc; do
      [ -n "$svc" ] || continue
      if systemctl --user is-active --quiet "$svc"; then ok "$svc active"; else warn "$svc not active"; fi
    done <<EOF
$configured_services
EOF
  else
    ok "No tray-ready services configured in startup.json"
  fi
else
  warn "startup.json missing; cannot inspect configured tray-ready services"
fi

section "Tray/status indicators"
if command -v dbus-send >/dev/null 2>&1; then
  tray_items="$(dbus-send --session --print-reply --dest=org.kde.StatusNotifierWatcher /StatusNotifierWatcher org.freedesktop.DBus.Properties.Get string:org.kde.StatusNotifierWatcher string:RegisteredStatusNotifierItems 2>/dev/null || true)"
  if [ -n "$configured_services" ]; then
    while IFS= read -r svc; do
      [ -n "$svc" ] || continue
      label="$(basename "$svc" .service | tr '[:upper:]' '[:lower:]')"
      echo "$tray_items" | tr '[:upper:]' '[:lower:]' | grep -qi "$label" && ok "$svc tray item detected" || warn "$svc tray item not detected"
    done <<EOF
$configured_services
EOF
  else
    ok "No configured tray-ready services to inspect for tray registration"
  fi
else
  warn "dbus-send missing; cannot inspect StatusNotifierWatcher"
fi

section "Audio/HDMI"
if has wpctl; then
  wpctl status 2>/dev/null | grep -qi 'HDMI' && ok "HDMI audio sink visible to PipeWire" || warn "HDMI audio sink not visible"
else
  warn "wpctl missing"
fi

section "Ethernet carrier"
for dev in enp18s0 enp6s0; do
  if [ -e "/sys/class/net/$dev/carrier" ]; then
    carrier="$(cat "/sys/class/net/$dev/carrier" 2>/dev/null || echo 0)"
    [ "$carrier" = 1 ] && ok "$dev carrier detected" || warn "$dev no carrier/link detected"
  fi
done

section "NVIDIA"
if has nvidia-smi; then
  nvidia-smi --query-gpu=name,driver_version --format=csv,noheader 2>/dev/null || warn "nvidia-smi failed"
else
  warn "nvidia-smi missing/not NVIDIA"
fi

section "Known workstation blockers"
ok "Mango DnD into Blender/Nuke: user-confirmed working"
ok "DMS Mango Settings companion GUI installed; native DMS integration still future work"

section "Done"
