#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP="$ROOT/tools/dms-mango-settings.py"

printf 'Compile settings app...\n'
python3 -m py_compile "$APP"

printf 'Run Qt offscreen smoke test...\n'
set +e
QT_QPA_PLATFORM=offscreen timeout 3s python3 "$APP" >/tmp/dms-mango-settings-smoke.log 2>&1
rc=$?
set -e
if [ "$rc" -eq 124 ]; then
  printf 'OK: app stayed up until timeout.\n'
elif [ "$rc" -eq 0 ]; then
  printf 'OK: app exited cleanly.\n'
else
  printf 'FAIL: app exited with %s\n' "$rc" >&2
  tail -80 /tmp/dms-mango-settings-smoke.log >&2 || true
  exit "$rc"
fi

printf 'Smoke log: /tmp/dms-mango-settings-smoke.log\n'
