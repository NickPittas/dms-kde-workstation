#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path

HOME = Path.home()
SETTINGS = HOME / ".config/DankMaterialShell/settings.json"

DOLPHIN_OVERRIDE = {
    "envVars": "QT_QPA_PLATFORMTHEME=qt6ct QT_QPA_PLATFORMTHEME_QT6=qt6ct"
}


def main() -> int:
    if not SETTINGS.exists():
        print(f"SKIP: {SETTINGS} not found")
        return 0
    data = json.loads(SETTINGS.read_text())
    if not isinstance(data, dict):
        print("FAIL: DMS settings file is not a JSON object")
        return 1
    overrides = data.get("appOverrides")
    if not isinstance(overrides, dict):
        overrides = {}
    current = overrides.get("org.kde.dolphin.desktop")
    if current == DOLPHIN_OVERRIDE:
        print("OK: Dolphin DMS launch override already present")
        return 0
    overrides["org.kde.dolphin.desktop"] = DOLPHIN_OVERRIDE
    data["appOverrides"] = overrides
    SETTINGS.write_text(json.dumps(data, indent=2) + "\n")
    print("OK: Added Dolphin DMS launch override")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
